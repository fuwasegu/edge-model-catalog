---
// edge-model-catalog — index page
// Data source: ../data/models.yaml (read at build time, never copied or edited).
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';

const raw = readFileSync(new URL('../../../data/models.yaml', import.meta.url), 'utf-8');
const data = parse(raw);
const models = (data.models ?? []) as any[];

const esc = (s: unknown) =>
  String(s ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

const sizeBand = (p: number | undefined) =>
  p == null ? '不明' : p < 1 ? '1B未満' : p < 2 ? '1B〜2B' : p <= 4 ? '2B〜4B' : '4B超';

const categories = [...new Set(models.flatMap((m) => m.categories ?? []))].sort();
const licenses = [...new Set(models.map((m) => m.license))].sort();
const modalities = [...new Set(models.flatMap((m) => m.modality ?? []))].sort();
const sizeBands = ['1B未満', '1B〜2B', '2B〜4B', '4B超', '不明'];
const covered = models.filter((m) => m.status === 'covered').length;
---

<!doctype html>
<html lang="ja" data-lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        document.documentElement.dataset.lang =
          localStorage.getItem('edge-model-catalog-lang') === 'en' ? 'en' : 'ja';
      } catch (_) {
        document.documentElement.dataset.lang = 'ja';
      }
    </script>
    <title>edge-model-catalog — 用途で探す小さなAIモデル</title>
    <meta name="description" content="〜4B級の小さなAIモデルを用途別に整理したカタログ。一次ソースで検証済みの40件を掲載。" />
    <style>
      :root { --bg:#f7f7f5; --card:#fff; --ink:#1a1a1a; --muted:#666; --line:#e3e3de; --accent:#0b6e4f; }
      * { box-sizing: border-box; }
      body { margin:0; font-family: system-ui, -apple-system, "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif; background:var(--bg); color:var(--ink); line-height:1.6; }
      header { padding: 2rem 1rem 1rem; max-width: 1080px; margin: 0 auto; }
      header h1 { margin:0 0 .25rem; font-size:1.8rem; }
      header p { margin:.25rem 0; color:var(--muted); }
      main { max-width: 1080px; margin: 0 auto; padding: 0 1rem 3rem; }
      .filters { position: sticky; top:0; z-index:10; background:var(--bg); padding:.75rem 0; border-bottom:1px solid var(--line); display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; }
      .filters input[type="search"], .filters select { padding:.5rem .6rem; font-size:.95rem; border:1px solid var(--line); border-radius:6px; background:#fff; }
      .filters input[type="search"] { flex:1 1 220px; min-width:180px; }
      .filters button { padding:.5rem .9rem; font-size:.95rem; border:1px solid var(--line); border-radius:6px; background:#fff; cursor:pointer; }
      .count { color:var(--muted); font-size:.9rem; }
      .lang-toggle { display:inline-flex; background:#fff; border:1px solid var(--line); border-radius:6px; overflow:hidden; }
      .lang-toggle button { border:0; border-radius:0; background:#fff; color:var(--ink); padding:.5rem .8rem; }
      .lang-toggle button + button { border-left:1px solid var(--line); }
      .lang-toggle button[aria-pressed="true"] { background:var(--accent); color:#fff; }
      html[data-lang="ja"] [data-lang="en"], html[data-lang="en"] [data-lang="ja"] { display:none !important; }
      .grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap:1rem; margin-top:1rem; }
      .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:1rem 1.1rem; display:flex; flex-direction:column; gap:.4rem; }
      .card h2 { margin:0; font-size:1.1rem; line-height:1.4; }
      .card h2 a { color:var(--ink); text-decoration:none; }
      .card h2 a:hover { color:var(--accent); text-decoration:underline; }
      .meta { font-size:.85rem; color:var(--muted); }
      .tags { display:flex; flex-wrap:wrap; gap:.3rem; }
      .tag { font-size:.78rem; background:#eef4f1; color:#0b6e4f; border-radius:999px; padding:.1rem .55rem; }
      .tag.license { background:#eef0f7; color:#33408a; }
      .hook { margin:.2rem 0 0; font-size:.95rem; }
      .caveats { margin:.2rem 0 0; font-size:.85rem; color:var(--muted); }
      .hf { margin-top:.5rem; display:flex; flex-direction:column; gap:.15rem; }
      .hf-btn { display:inline-block; align-self:flex-start; background:#ffd21e; color:#1a1a1a; border:1px solid #dfae00; border-radius:6px; padding:.3rem .7rem; font-size:.88rem; font-weight:600; text-decoration:none; }
      .hf-btn:hover { background:#ffdc4d; text-decoration:underline; }
      .hf-path { font-size:.75rem; color:var(--muted); word-break:break-all; }
      .foot { margin-top:auto; font-size:.82rem; color:var(--muted); display:flex; justify-content:space-between; gap:.5rem; flex-wrap:wrap; }
      .badge { font-size:.75rem; border:1px solid var(--line); border-radius:999px; padding:.05rem .5rem; }
      .empty { display:none; padding:2rem 0; color:var(--muted); }
      footer { max-width:1080px; margin:0 auto; padding:0 1rem 2rem; color:var(--muted); font-size:.85rem; }
    </style>
    <!-- Cloudflare Web Analytics --><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "801e137983094c1dada3a5983489db7e"}'></script><!-- End Cloudflare Web Analytics -->
  </head>
  <body>
    <header>
      <h1>edge-model-catalog</h1>
      <p>〜4B級の小さなAIモデルを、用途で探すカタログ。{models.length}件掲載（詳細紹介済み {covered}件・カード精読の候補 {models.length - covered}件）。すべての情報は一次ソース（モデルカード／公式発表）で検証済み。</p>
    </header>
    <main>
      <div class="filters" id="filters">
        <input type="search" id="q" placeholder="名前・提供元・概要で検索…" aria-label="検索" />
        <select id="category" aria-label="用途カテゴリ">
          <option value="">用途：すべて</option>
          {categories.map((c) => <option value={c}>{c}</option>)}
        </select>
        <select id="license" aria-label="ライセンス">
          <option value="">ライセンス：すべて</option>
          {licenses.map((l) => <option value={l}>{l}</option>)}
        </select>
        <select id="modality" aria-label="モダリティ">
          <option value="">モダリティ：すべて</option>
          {modalities.map((m) => <option value={m}>{m}</option>)}
        </select>
        <select id="size" aria-label="サイズ帯">
          <option value="">サイズ：すべて</option>
          {sizeBands.map((s) => <option value={s}>{s}</option>)}
        </select>
        <select id="status" aria-label="掲載ステータス">
          <option value="">ステータス：すべて</option>
          <option value="covered">詳細紹介済み</option>
          <option value="candidate">候補（カード精読）</option>
        </select>
        <button id="reset" type="button">リセット</button>
        <div class="lang-toggle" role="group" aria-label="説明の言語">
          <button type="button" data-lang-choice="ja" aria-pressed="true">日本語</button>
          <button type="button" data-lang-choice="en" aria-pressed="false">English</button>
        </div>
        <span class="count" id="count"></span>
      </div>

      <div class="grid" id="grid">
        {models.map((m) => (
          <article class="card"
            data-search={`${m.name} ${m.provider} ${m.hook ?? ''} ${m.hook_ja ?? ''} ${m.caveats ?? ''} ${m.caveats_ja ?? ''}`.toLowerCase()}
            data-categories={(m.categories ?? []).join(',')}
            data-license={m.license}
            data-modalities={(m.modality ?? []).join(',')}
            data-size={sizeBand(m.params_b)}
            data-status={m.status}>
            <h2><a href={m.url} target="_blank" rel="noopener">{m.name}</a></h2>
            <div class="meta">
              {m.provider}
              {m.params_b != null ? ` ・ 約${m.params_b}B` : ' ・ サイズ不明'}
              {m.base_model ? ` ・ ベース: ${m.base_model}` : ''}
            </div>
            <div class="tags">
              {(m.categories ?? []).map((c: string) => <span class="tag">{c}</span>)}
              <span class="tag license">{m.license}</span>
            </div>
            <p class="hook" data-lang="en" lang="en">{m.hook}</p>
            {m.hook_ja && <p class="hook" data-lang="ja" lang="ja">{m.hook_ja}</p>}
            {m.caveats && <p class="caveats" data-lang="en" lang="en">Note: {m.caveats}</p>}
            {m.caveats_ja && <p class="caveats" data-lang="ja" lang="ja">注意：{m.caveats_ja}</p>}
            {m.license_note && <p class="caveats">ライセンス注記：{m.license_note}</p>}
            <div class="hf">
              <a class="hf-btn" href={m.url} target="_blank" rel="noopener">Hugging Face で見る ↗</a>
              <span class="hf-path">{m.url.replace('https://', '')}</span>
            </div>
            <div class="foot">
              <span>{m.status === 'covered' ? '詳細紹介済み' : '候補'} ・ 公開 {m.released} ・ 確認 {m.verified}</span>
              <a href={m.url} target="_blank" rel="noopener">一次ソース ↗</a>
            </div>
          </article>
        ))}
      </div>
      <p class="empty" id="empty">条件に合うモデルがありません。フィルタをゆるめてみてください。</p>
    </main>
    <footer>
      <p>データ：<code>data/models.yaml</code>（40件・一次ソース検証済み）。数値は提供元計測が基本で、注意点も併記しています。説明はページ上部のトグルで日本語と英語を切り替えられ、各モデルから Hugging Face のモデルページへ直接リンクしています。Astro製の静的サイトです。</p>
    </footer>
    <script>
      const $ = (id) => document.getElementById(id);
      const q = $('q'), category = $('category'), license = $('license'),
            modality = $('modality'), size = $('size'), status = $('status'),
            count = $('count'), empty = $('empty');
      const cards = [...document.querySelectorAll('.card')];
      const langButtons = [...document.querySelectorAll('[data-lang-choice]')];
      const langStorageKey = 'edge-model-catalog-lang';
      function setLang(lang, save = true) {
        const next = lang === 'en' ? 'en' : 'ja';
        document.documentElement.dataset.lang = next;
        for (const button of langButtons) {
          button.setAttribute('aria-pressed', String(button.dataset.langChoice === next));
        }
        if (save) {
          try { localStorage.setItem(langStorageKey, next); } catch (_) {}
        }
      }
      for (const button of langButtons) {
        button.addEventListener('click', () => setLang(button.dataset.langChoice));
      }
      let savedLang = null;
      try { savedLang = localStorage.getItem(langStorageKey); } catch (_) {}
      setLang(savedLang || document.documentElement.dataset.lang || 'ja', false);
      function apply() {
        const needle = q.value.trim().toLowerCase();
        let shown = 0;
        for (const card of cards) {
          const ok =
            (!needle || card.dataset.search.includes(needle)) &&
            (!category.value || card.dataset.categories.split(',').includes(category.value)) &&
            (!license.value || card.dataset.license === license.value) &&
            (!modality.value || card.dataset.modalities.split(',').includes(modality.value)) &&
            (!size.value || card.dataset.size === size.value) &&
            (!status.value || card.dataset.status === status.value);
          card.style.display = ok ? '' : 'none';
          if (ok) shown++;
        }
        count.textContent = `${shown} / ${cards.length} 件`;
        empty.style.display = shown === 0 ? '' : 'none';
      }
      for (const el of [q, category, license, modality, size, status]) {
        el.addEventListener('input', apply);
        el.addEventListener('change', apply);
      }
      $('reset').addEventListener('click', () => {
        q.value = ''; category.value = ''; license.value = '';
        modality.value = ''; size.value = ''; status.value = '';
        apply();
      });
      apply();
    </script>
  </body>
</html>
